# ============================================================
# Antarctic Navigation DSS - Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit the real .env with secrets to version control.
# ============================================================

# --- Application ---
APP_NAME=Antarctic Navigation DSS
APP_VERSION=0.2.0
DEBUG=true
LOG_LEVEL=INFO

# --- Demo mode ---
# auto  -> demo flag derived from actual data classification (recommended)
# force -> always report/label everything as demo, even with real data
# off   -> never force demo (classification still reported per dataset)
DEMO_MODE=auto

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# SQLite initially (default). PostgreSQL/PostGIS planned for later phases.
DATABASE_URL=sqlite:///./antarctic_dss.db

# --- Model selection (persistence | random_forest | convlstm / lstm) ---
SEA_ICE_MODEL=persistence
ICEBERG_MODEL=persistence

# --- Data sources (optional; leave empty to use synthetic demo data) ---
# Sea-ice NetCDF file path, if you have a local NSIDC/Copernicus field.
SEA_ICE_NETCDF_PATH=
# Iceberg track data file (JSON/GeoJSON), if you have a local dataset.
ICEBERG_DATA_PATH=

# --- Remote data APIs (keep secret - never commit) ---
# Copernicus Marine Service credentials (MOTU client). Required for
# scripts/download_ocean.py and the Copernicus sea-ice path.
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# Optional overrides. See data_pipeline/common/config.py for defaults.
# COPERNICUS_MOTU_URL=https://my.cmems-du.eu/motu-web/Motu
# COPERNICUS_MOTU_USER=
# COPERNICUS_MOTU_PASS=
# COPERNICUS_OCEAN_DATASET_ID=cmems_mod_glo_phy_my_0.083deg_P1D-m
# COPERNICUS_OCEAN_VARIABLES=uo,vo,thetao,so
# COPERNICUS_SEAICE_DATASET_ID=cmems_obs-ice_arc_physic_nrt_1km-2D_P1D-m
# COPERNICUS_SEAICE_LAT_MIN=-89|LAT_MAX=-56|LON_MIN=-179.5|LON_MAX=179.5

# ERA5 (Copernicus Climate Data Store, CDS API). Required for
# scripts/download_weather.py. Requires `pip install cdsapi`.
# CDS_API_URL=https://cds.climate.copernicus.eu/api
# CDS_API_KEY=uid:api-key

# NSIDC daily sea-ice (optional, experimental). The operator supplies a
# URL pattern with a {date} placeholder, e.g.:
# NSIDC_SEA_ICE_URL_PATTERN=https://example.org/sic/{date}/sic_{date}.nc
# NSIDC_API_TOKEN=

# --- Pipeline behavior ---
# PIPELINE_RETRIES=3
# PIPELINE_SKIP_EXISTING=true
# Data output roots (default to <repo>/backend/datasets).
# DATA_RAW_ROOT=
# DATA_PROCESSED_ROOT=
# DATA_REPORTS_ROOT=
# DATA_IMPORTS_ROOT=

# --- Vessel / journey defaults ---
DEFAULT_VESSEL_ID=polar_explorer
DEFAULT_DEPARTURE_PORT_ID=hobart_au
DEFAULT_DESTINATION_ID=mcmurdo_us
DEFAULT_JOURNEY_MODE=outbound

# --- Research-station ocean approach ---
# Research centers on land route to the nearest navigable ocean cell.
# Distances above this threshold (km) surface an explicit warning.
# RESEARCH_STATION_APPROACH_DISTANCE_KM=100

# --- Simulation ---
SIMULATION_TIME_STEP_HOURS=2
SIMULATION_MAX_HOURS=720
REAL_TIME_MULTIPLIER=1

# --- AI Assistant (LLM) ---
# auto     -> use OpenAI (or Anthropic) if a key is set, else fall back to
#             the built-in template answers (no LLM required to run the demo)
# openai   -> force OpenAI (requires OPENAI_API_KEY)
# anthropic-> force Anthropic (requires ANTHROPIC_API_KEY)
# ollama   -> local Ollama server (no key needed; started separately)
# none     -> always use template answers
ASSISTANT_PROVIDER=auto
ASSISTANT_MODEL=

# OpenAI-compatible endpoint. Leave unset for api.openai.com.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b